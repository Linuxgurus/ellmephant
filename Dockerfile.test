# syntax=docker/dockerfile:1
#
# The CI gate: format, lints and the test suite, in a throwaway image.
#
# Built -- never run -- by the `test` job of `.forgejo/workflows/publish-dev.yml`, and made a
# `needs` of that file's `publish` job, so a push to `dev` cannot publish `edge` from code that does
# not pass. The same job runs on a `pull request`, which is the only way a PR gets a status here.
#
# Deliberately STANDALONE: it needs no secrets and no private registry, so it runs identically on a
# `dev` push and on a pull request. The only thing it asks of the world is a base image, and the
# base is a build-arg:
#
#   BUILDER = a prebuilt dependency image (Dockerfile.gate-builder), when one exists for this
#             lockfile. Measured 2026-10-26: 336 compiles -> 57, 612 s -> 476 s.
#   BUILDER = rust:1-bookworm (the default) otherwise — a PR that changes Cargo.lock, or the first
#             run before the image exists. That costs the full dependency compile, never a wrong
#             answer, which is the property this file has always had.
#
# The caller (.forgejo/workflows/test.yml) picks, by checking Harbor for the tag first.
ARG BUILDER=rust:1-bookworm
FROM ${BUILDER}

WORKDIR /src
# `.dockerignore` keeps target/, .git/ and the scratch dir out of the context.
COPY . .

# ★ TOUCH, because cargo fingerprints by mtime. When BUILDER is a dependency image that was built
# AFTER this checkout -- which happens whenever the image is rebuilt and used in the same pipeline
# -- the stub artifacts inside it look NEWER than the source just copied in, and cargo keeps the
# stub's empty lib. The build then dies with "cannot find `embed` in `ellmephant`", which names
# the wrong problem. In normal CI the image is older than the commit and this is a no-op.
RUN if [ -d benches ]; then find src tests benches -type f -exec touch {} +; else find src tests -type f -exec touch {} +; fi

# The official image carries rustup but NOT the `rustfmt`/`clippy` components, and the gates below
# need both. (Learned the loud way: the first probe died at `cargo fmt` with "'cargo-fmt' is not
# installed for the toolchain".)
RUN rustup component add rustfmt clippy

# Fetch the registry up front, in its own layer, so a network problem (a restricted egress policy
# would do it) is ONE loud early failure rather than a random failure in the middle of a compile.
RUN cargo fetch --locked

# One cargo step at a time, on purpose: they contend on the target-dir lock (DEVELOPMENT.md), and a
# separate layer makes a failure name itself instead of scrolling past in one long log.
#
# ★ NO CACHE MOUNT HERE (2026-10-30, Stet on #188). A BuildKit cache mount SHADOWS whatever the image
# put at that path. The dependency image's payload IS `/src/target`, so
# `--mount=type=cache,target=/src/target` hid the prebuilt crates at every cargo step and the gate
# recompiled exactly as before — the feature was a no-op. Cargo writes into the image's `/src/target`
# instead. On the `rust:1-bookworm` fallback those artifacts live in a throwaway container layer,
# which is exactly what the fallback always did.
RUN cargo fmt --all --check
RUN cargo clippy --all-targets --all-features -- -D warnings
RUN cargo test --locked
# The store-only build must compile too (the encoder is behind a default-on feature).
RUN cargo test --locked --no-default-features
